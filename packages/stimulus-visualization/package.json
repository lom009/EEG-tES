{
  "name": "@eeg-tes/stimulus-visualization",
  "version": "0.5.1",
  "description": "Reusable EEG-tES stimulus path, point, and value visualization for React.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/stimulus-visualization.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node ./test/model.test.mjs",
    "build": "vite build",
    "preview:demo": "vite ./demo --config ./demo/vite.config.js --host 127.0.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
