<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">..\EGGtCSPlatform.Desktop\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\EGGtCSPlatform.SpeechTraining.Tests\ControllableSpeechAudioPlayer.cs" Link="TestSupport\ControllableSpeechAudioPlayer.cs" />
    <Compile Include="..\EGGtCSPlatform.SpeechTraining.Tests\AudioUsings.cs" Link="TestSupport\AudioUsings.cs" />
    <ProjectReference Include="..\EGGtCSPlatform\EGGtCSPlatform.csproj" />
  </ItemGroup>
</Project>
