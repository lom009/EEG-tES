<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:vm="clr-namespace:EGGtCSPlatform.ViewModels"
  x:Class="EGGtCSPlatform.Views.SingleStimulusExperimentDialogView"
  x:DataType="vm:SingleStimulusExperimentDialogViewModel"
>
  <Border
    Width="415"
    MinHeight="328"
    Margin="24"
    Padding="24"
    Background="White"
    CornerRadius="8"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
  >
    <StackPanel Spacing="0">
      <Grid Height="24" ColumnDefinitions="*,24">
        <TextBlock
          Text="单刺激实验"
          FontSize="16"
          FontWeight="Medium"
          Foreground="#232B38"
          VerticalAlignment="Center"
        />
        <Button
          Grid.Column="1"
          Width="24"
          Height="24"
          Padding="4"
          Background="Transparent"
          BorderThickness="0"
          Command="{Binding CloseExperimentCommand}"
          IsEnabled="{Binding CanClose}"
          AutomationProperties.Name="关闭单刺激实验"
        >
          <Path
            Width="14"
            Height="14"
            Data="M 0,0 L 14,14 M 0,14 L 14,0"
            Stroke="#232B38"
            StrokeThickness="2"
          />
        </Button>
      </Grid>
      <Border Height="120" Margin="0,24,0,0" Background="#0D9536F3" ClipToBounds="False">
        <controls:StimulusOverviewCard
          Width="177"
          FontSize="12"
          Padding="18,8"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Descriptor="{Binding Waveform}"
          CurrentText="{Binding CurrentText}"
          StatusText="{Binding StatusText}"
        />
      </Border>
      <Grid Margin="0,24,0,0" Height="32" ColumnDefinitions="Auto,8,72,4,72,*,Auto">
        <TextBlock Text="刺激时长" VerticalAlignment="Center" FontSize="14" Foreground="#7889A1" />
        <controls:ExperimentDurationInput
          Grid.Column="2"
          Height="32"
          FontSize="14"
          Padding="8,0"
          Background="White"
          BorderBrush="#DDE6F2"
          BorderThickness="1"
          CornerRadius="6"
          CommittedValue="{Binding Duration.DurationValue, Mode=TwoWay}"
          Unit="{Binding Duration.SelectedUnit}"
          StepMilliseconds="{Binding Duration.DurationStepMilliseconds}"
          MinimumMilliseconds="{Binding Duration.DurationMinimumMilliseconds}"
          MaximumMilliseconds="{Binding Duration.DurationMaximumMilliseconds}"
          IsEnabled="{Binding CanEdit}"
          ShowButtonSpinner="False"
        />
        <ComboBox
          Grid.Column="4"
          Height="32"
          FontSize="14"
          Padding="8,0"
          Background="White"
          BorderBrush="#DDE6F2"
          BorderThickness="1"
          CornerRadius="6"
          ItemsSource="{Binding Duration.Units}"
          SelectedItem="{Binding Duration.SelectedUnit, Mode=TwoWay}"
          IsEnabled="{Binding CanEdit}"
          Theme="{StaticResource ExperimentRunInlineComboBoxTheme}"
        />
        <StackPanel
          Grid.Column="6"
          Orientation="Horizontal"
          Spacing="6"
          VerticalAlignment="Center"
          IsVisible="{Binding ShowRemaining}"
          AutomationProperties.Name="剩余时间"
        >
          <Viewbox Width="16" Height="16">
            <Canvas Width="16" Height="16">
              <Ellipse
                Width="11"
                Height="11"
                Canvas.Left="2.5"
                Canvas.Top="3.5"
                Stroke="#6B7D99"
                StrokeThickness="1.3"
              />
              <Path
                Data="M 5.3,1.3 L 10.7,1.3 M 8,1.3 L 8,3.5 M 8,5.3 L 8,8.7 L 11.3,8.7 M 11.7,4 L 13,2.7"
                Stroke="#6B7D99"
                StrokeThickness="1.3"
              />
            </Canvas>
          </Viewbox>
          <TextBlock Text="{Binding RemainingText}" FontSize="14" Foreground="#232B38" />
        </StackPanel>
      </Grid>
      <TextBlock
        Margin="0,6,0,0"
        Text="{Binding Duration.ValidationText}"
        IsVisible="{Binding Duration.HasValidationError}"
        TextWrapping="Wrap"
        Foreground="#EE525C"
        FontSize="12"
      />
      <TextBlock
        Margin="0,6,0,0"
        Text="{Binding ErrorText}"
        IsVisible="{Binding HasError}"
        TextWrapping="Wrap"
        Foreground="#EE525C"
        FontSize="12"
      />
      <TextBlock
        Margin="0,6,0,0"
        Text="{Binding ElapsedText}"
        IsVisible="{Binding IsReadOnly}"
        FontSize="12"
      />
      <TextBlock
        Margin="0,6,0,0"
        Text="{Binding HistorySummary}"
        IsVisible="{Binding IsReadOnly}"
        TextWrapping="Wrap"
        FontSize="12"
      />
      <controls:ExperimentRunActions
        Margin="0,24,0,0"
        ButtonHeight="32"
        ShowStartIcon="True"
        IsCompletion="{Binding IsFinished}"
        CompletionCommand="{Binding CloseExperimentCommand}"
        IsCompletionEnabled="{Binding CanClose}"
        IsVisible="{Binding !IsReadOnly}"
        PrimaryText="开始实验"
        PrimaryCommand="{Binding StartCommand}"
        IsPrimaryEnabled="{Binding CanStart}"
        EmergencyCommand="{Binding EmergencyStopCommand}"
        IsEmergencyEnabled="{Binding CanEmergencyStop}"
      />
    </StackPanel>
  </Border>
</UserControl>
