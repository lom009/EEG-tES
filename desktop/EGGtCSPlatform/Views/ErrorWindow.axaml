<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:EGGtCSPlatform.Views"
  xmlns:vm="clr-namespace:EGGtCSPlatform.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="500"
  d:DesignHeight="350"
  Width="500"
  Height="350"
  MinWidth="500"
  MinHeight="350"
  Icon="/Assets/Images/icon.ico"
  WindowStartupLocation="CenterScreen"
  Topmost="True"
  x:Class="EGGtCSPlatform.Views.ErrorWindow"
  Title="EGGtCSPlatform Error"
  xmlns:design="clr-namespace:EGGtCSPlatform.Design"
  d:DataContext="{x:Static design:DesignData.ErrorViewModel}"
>
  <local:ErrorView />
</Window>
