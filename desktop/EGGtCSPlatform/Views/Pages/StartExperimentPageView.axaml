<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:views="clr-namespace:EGGtCSPlatform.Views.Pages"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:Class="EGGtCSPlatform.Views.Pages.StartExperimentPageView"
  x:Name="Root"
  x:DataType="pages:StartExperimentPageViewModel"
  FontFamily="{DynamicResource AlibabaPuHuiTi}"
  FontWeight="Normal"
  Foreground="#232B38"
  mc:Ignorable="d"
  d:DesignWidth="1440"
  d:DesignHeight="768"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Controls/HistoryControlThemes.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    <ControlTheme x:Key="ExperimentModeOptionTheme" TargetType="RadioButton">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{DynamicResource AlibabaPuHuiTi}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize14}" />
      <Setter Property="Foreground" Value="#232B38" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
            x:Name="ModeSurface"
            Background="{TemplateBinding Background}"
            CornerRadius="{TemplateBinding CornerRadius}"
          >
            <ContentPresenter
              Margin="20,0,20,0"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding Content}"
            />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ModeSurface">
        <Setter Property="Background" Value="#F3F5FF" />
      </Style>
      <Style Selector="^:checked /template/ Border#ModeSurface">
        <Setter Property="Background" Value="#3941B6" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="White" />
      </Style>
    </ControlTheme>
      </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.page-tab TextBlock">
      <Setter Property="Foreground" Value="#232B38" />
    </Style>
    <Style Selector="Button.page-tab.active TextBlock">
      <Setter Property="Foreground" Value="#3941B6" />
    </Style>
    <Style Selector="Border.page-tab-indicator">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
      <Setter Property="RenderTransform" Value="translate(16px, 0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition
            Property="Width"
            Duration="0:0:0.28"
            Easing="CubicEaseInOut"
          />
          <TransformOperationsTransition
            Property="RenderTransform"
            Duration="0:0:0.28"
            Easing="CubicEaseInOut"
          />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.page-tab-indicator.history-selected">
      <Setter Property="Width" Value="96"/>
      <Setter Property="RenderTransform" Value="translate(96px, 0px)" />
    </Style>
    <Style Selector="Border.page-tab-indicator.tolerance-selected">
      <Setter Property="Width" Value="112"/>
      <Setter Property="RenderTransform" Value="translate(192px, 0px)" />
    </Style>
    <StyleInclude Source="/Controls/ExperimentInputStyles.axaml"/>

    <StyleInclude Source="/Controls/HistoryStyles.axaml"/>
  </UserControl.Styles>

  <Border Margin="24,0,24,24" Background="White" BoxShadow="0 4 12 0 #246885B3" CornerRadius="8">
    <Grid RowDefinitions="56,*">
      <Grid Grid.Row="0">
        <Border
          Margin="16,0"
          VerticalAlignment="Bottom"
          BorderBrush="#E2E8F2"
          BorderThickness="0,0,0,1"
        />
        <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
          <Button
            Width="96"
            Height="56"
            Classes="page-tab"
            Classes.active="{Binding IsNewExperimentSelected}"
            Command="{Binding SelectNewExperimentCommand}"
            Theme="{StaticResource ExperimentButtonTheme}"
          >
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontFamily="{DynamicResource AlibabaPuHuiTi}"
              FontWeight="Medium"
              FontSize="{DynamicResource FontSize16}"
              Text="新建实验"
            />
          </Button>
          <Button
            Width="96"
            Height="56"
            Classes="page-tab"
            Classes.active="{Binding IsHistorySelected}"
            Command="{Binding SelectHistoryCommand}"
            Theme="{StaticResource ExperimentButtonTheme}"
          >
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontFamily="{DynamicResource AlibabaPuHuiTi}"
              FontWeight="Medium"
              FontSize="{DynamicResource FontSize16}"
              Text="历史记录"
            />
          </Button>
          <Button Width="112" Height="56" Classes="page-tab" Classes.active="{Binding IsToleranceHistorySelected}"
            Command="{Binding SelectToleranceHistoryCommand}" Theme="{StaticResource ExperimentButtonTheme}"><TextBlock Text="耐受度记录" FontSize="{DynamicResource FontSize16}" FontWeight="Medium"/></Button>
        </StackPanel>
        <Border
          Height="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          Background="#3941B6"
          Classes="page-tab-indicator"
          Classes.history-selected="{Binding IsHistorySelected}"
          Classes.tolerance-selected="{Binding IsToleranceHistorySelected}"
          IsHitTestVisible="False"
        />
      </Grid>

      <Grid
        Grid.Row="1"
        Margin="16,16,16,20"
        RowDefinitions="170,16,152,16,1*,18,32"
        IsVisible="{Binding IsNewExperimentSelected}"
      >
        <Border Grid.Row="0" BorderBrush="#E5EFFB" BorderThickness="1" CornerRadius="6">
          <Grid RowDefinitions="48,*">
            <StackPanel
              Margin="16,0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="4"
            >
              <Image
                Width="24"
                Height="24"
                Source="{SvgImage /Assets/Images/experiment-summary-icon.svg}"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="{DynamicResource AlibabaPuHuiTi}"
                FontWeight="Medium"
                FontSize="{DynamicResource FontSize16}"
                Text="实验摘要"
              />
            </StackPanel>

            <Grid Grid.Row="1" Margin="16,0,16,16" ColumnDefinitions="*,12,*,12,*">
              <Border Grid.Column="0" Padding="24,0" Background="#F8FAFC">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                  <TextBlock
                    FontSize="{DynamicResource FontSize14}"
                    Foreground="#6B7D99"
                    Text="实验ID"
                  />
                  <TextBlock
                    FontFamily="{DynamicResource AlibabaPuHuiTi}"
                    FontWeight="Medium"
                    FontSize="{DynamicResource FontSize16}"
                    Text="{Binding ExperimentId}"
                  />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="24,0" Background="#F8FAFC">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                  <TextBlock
                    FontSize="{DynamicResource FontSize14}"
                    Foreground="#6B7D99"
                    Text="日期"
                  />
                  <controls:DateSelectionPicker
                    x:Name="ExperimentDatePicker"
                    Width="280"
                    Height="40"
                    HorizontalAlignment="Left"
                    SelectedDate="{Binding SelectedExperimentDate, Mode=TwoWay}"
                  />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="24,0" Background="#F8FAFC">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                  <TextBlock
                    FontSize="{DynamicResource FontSize14}"
                    Foreground="#6B7D99"
                    Text="模式选择"
                  />
                  <Border
                    Height="40"
                    HorizontalAlignment="Left"
                    Background="White"
                    BorderBrush="#D9DEE6"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="4"
                  >
                    <Grid ColumnDefinitions="*,1,*,1,*">
                      <RadioButton
                        Grid.Column="0"
                        Command="{Binding SelectExperimentModeCommand}"
                        CommandParameter="{x:Static pages:ExperimentCreationMode.StimulusOnly}"
                        Content="单刺激模式"
                        CornerRadius="4,0,0,4"
                        GroupName="ExperimentCreationMode"
                        IsChecked="{Binding IsStimulusOnlyMode, Mode=OneWay}"
                        Theme="{StaticResource ExperimentModeOptionTheme}"
                      />
                      <Border Grid.Column="1" Background="#D9DEE6" IsHitTestVisible="False" />
                      <RadioButton
                        Grid.Column="2"
                        Command="{Binding SelectExperimentModeCommand}"
                        CommandParameter="{x:Static pages:ExperimentCreationMode.AcquisitionOnly}"
                        Content="单采集模式"
                        CornerRadius="0"
                        GroupName="ExperimentCreationMode"
                        IsChecked="{Binding IsAcquisitionOnlyMode, Mode=OneWay}"
                        Theme="{StaticResource ExperimentModeOptionTheme}"
                      />
                      <Border Grid.Column="3" Background="#D9DEE6" IsHitTestVisible="False" />
                      <RadioButton
                        Grid.Column="4"
                        Command="{Binding SelectExperimentModeCommand}"
                        CommandParameter="{x:Static pages:ExperimentCreationMode.AcquisitionAndStimulation}"
                        Content="采集-刺激模式"
                        CornerRadius="0,4,4,0"
                        GroupName="ExperimentCreationMode"
                        IsChecked="{Binding IsAcquisitionAndStimulationMode, Mode=OneWay}"
                        Theme="{StaticResource ExperimentModeOptionTheme}"
                      />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#E5EFFB" BorderThickness="1" CornerRadius="6">
          <Grid RowDefinitions="48,40,48,16">
            <StackPanel
              Margin="16,0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="4"
            >
              <Image
                Width="24"
                Height="24"
                Source="{SvgImage /Assets/Images/subject-info-icon.svg}"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="{DynamicResource AlibabaPuHuiTi}"
                FontWeight="Medium"
                FontSize="{DynamicResource FontSize16}"
                Text="被试信息"
              />
            </StackPanel>

            <Grid Grid.Row="1" Margin="16,0" ColumnDefinitions="64,300,8,88,16,Auto,*">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Foreground="#E91919" Text="*" />
                <TextBlock
                  FontSize="{DynamicResource FontSize14}"
                  Foreground="#6B7D99"
                  Text="被试ID"
                />
              </StackPanel>
              <TextBox
                x:Name="SubjectIdInput"
                Grid.Column="1"
                Classes="experiment-input"
                PlaceholderText="请输入被试ID，如 SUB001"
                Text="{Binding SubjectId}"
              />
              <Button
                Grid.Column="3"
                Height="32"
                Padding="10,0"
                Background="White"
                BorderBrush="#D9DEE6"
                BorderThickness="1"
                CornerRadius="4"
                Command="{Binding GenerateSubjectIdCommand}"
                Theme="{StaticResource ExperimentButtonTheme}"
              >
                <TextBlock FontSize="{DynamicResource FontSize13}" Text="随机生成" />
              </Button>
              <Button
                Grid.Column="5"
                Padding="0"
                Command="{Binding SelectHistoryCommand}"
                Theme="{StaticResource ExperimentButtonTheme}"
              >
                <TextBlock
                  FontSize="{DynamicResource FontSize14}"
                  Foreground="#3941B6"
                  Text="导入历史配置"
                />
              </Button>
            </Grid>
            <Popup
              Grid.Row="1"
              IsOpen="{Binding HasSubjectCandidates}"
              Placement="Bottom"
              PlacementTarget="{Binding #SubjectIdInput}"
            >
              <Border
                Width="300"
                MaxHeight="180"
                Background="White"
                BorderBrush="#D9DEE6"
                BorderThickness="1"
                BoxShadow="0 4 10 #30000000"
              >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SubjectCandidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Padding="12,7"
                          Background="White"
                          BorderThickness="0"
                          Command="{Binding $parent[ItemsControl].DataContext.SelectSubjectCandidateCommand}"
                          CommandParameter="{Binding}"
                          Theme="{StaticResource ExperimentButtonTheme}"
                        >
                          <TextBlock Text="{Binding}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Popup>

            <Grid Grid.Row="2" Margin="16,0" ColumnDefinitions="64,*">
              <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource FontSize14}"
                Foreground="#6B7D99"
                Text="备注"
                TextAlignment="Right"
              />
              <TextBox
                Grid.Column="1"
                Margin="0,0,0,0"
                Classes="experiment-input"
                PlaceholderText="可选，如首次采集"
                Text="{Binding Remarks}"
              />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="#E5EFFB" BorderThickness="1" CornerRadius="6">
          <Grid RowDefinitions="48,*">
            <StackPanel
              Margin="16,0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="4"
            >
              <Image
                Width="24"
                Height="24"
                Source="{SvgImage /Assets/Images/import-parameters-icon.svg}"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="{DynamicResource AlibabaPuHuiTi}"
                FontWeight="Medium"
                FontSize="{DynamicResource FontSize16}"
                Text="导入实验参数包"
              />
            </StackPanel>

            <Grid Grid.Row="1" Margin="16,0,16,16">
              <Rectangle
                Fill="#F7F9FC"
                RadiusX="4"
                RadiusY="4"
                Stroke="#D7E2F2"
                StrokeDashArray="4,4"
                StrokeThickness="1"
              />
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="40"
                IsVisible="{Binding !HasImportedTemplate}"
              >
                <Image
                  Width="86"
                  Height="98"
                  Source="{SvgImage /Assets/Images/experiment-package.svg}"
                  Stretch="Uniform"
                />
                <StackPanel VerticalAlignment="Center" Spacing="10">
                  <Button
                    Height="40"
                    Padding="16,0"
                    Background="White"
                    BorderBrush="#EBEFF5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Command="{Binding ImportPackageCommand}"
                    Theme="{StaticResource ExperimentButtonTheme}"
                  >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image
                        Width="24"
                        Height="24"
                        Source="{SvgImage /Assets/Images/upload-cloud-icon.svg}"
                      />
                      <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AlibabaPuHuiTi}"
                        FontWeight="Medium"
                        FontSize="{DynamicResource FontSize14}"
                        Text="选择文件"
                      />
                    </StackPanel>
                  </Button>
                  <TextBlock
                    FontSize="{DynamicResource FontSize14}"
                    Foreground="#6B7D99"
                    Text="支持导入.expp 文件，快速复用已有实验配置"
                  />
                </StackPanel>
              </StackPanel>
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                IsVisible="{Binding HasImportedTemplate}"
              >
                <TextBlock
                  HorizontalAlignment="Center"
                  FontFamily="{DynamicResource AlibabaPuHuiTi}"
                  FontWeight="Medium"
                  FontSize="{DynamicResource FontSize16}"
                  Text="{Binding ImportedTemplateSource}"
                />
                <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="{DynamicResource FontSize13}"
                  Foreground="#6B7D99"
                  Text="{Binding ImportedTemplateSummary}"
                />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                  <Button
                    Height="32"
                    Padding="14,0"
                    Background="White"
                    BorderBrush="#D9DEE6"
                    BorderThickness="1"
                    CornerRadius="4"
                    Command="{Binding ClearImportedTemplateCommand}"
                    Theme="{StaticResource ExperimentButtonTheme}"
                  >
                    <TextBlock Text="清空配置" />
                  </Button>
                  <Button
                    Height="32"
                    Padding="14,0"
                    Background="White"
                    BorderBrush="#3941B6"
                    BorderThickness="1"
                    CornerRadius="4"
                    Command="{Binding ImportPackageCommand}"
                    Theme="{StaticResource ExperimentButtonTheme}"
                  >
                    <TextBlock Foreground="#3941B6" Text="导入另一个" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Button
          Grid.Row="6"
          Height="32"
          Padding="16,0"
          HorizontalAlignment="Right"
          Background="#3941B6"
          Command="{Binding EnterStimulusConfigurationCommand}"
          CornerRadius="6"
          Theme="{StaticResource ExperimentButtonTheme}"
        >
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image
              Width="20"
              Height="20"
              Source="{SvgImage /Assets/Images/check-double-line.svg}"
            />
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="{DynamicResource AlibabaPuHuiTi}"
              FontWeight="Medium"
              FontSize="{DynamicResource FontSize14}"
              Foreground="White"
              Text="{Binding ConfigurationEntryText}"
            />
          </StackPanel>
        </Button>
      </Grid>


      <!-- Figma 248:3704. Keep all existing filters, commands and row bindings. -->
      <Grid
        Grid.Row="1"
        Margin="16,16,16,20"
        Classes="history-page"
        RowDefinitions="32,16,Auto,16,*,16,32"
        IsVisible="{Binding IsHistorySelected}"
      >
        <Grid
          x:Name="HistoryFilterBar"
          ColumnDefinitions="1.2*,10,0.85*,10,0.85*,10,2*,10,64,8,64"
          IsEnabled="{Binding IsHistoryInteractionEnabled}"
        >
          <Grid>
            <TextBox
              x:Name="HistorySearchBox"
              Classes="history-search"
              PlaceholderText="搜索实验ID或被试ID"
              Text="{Binding HistorySearchText, Mode=TwoWay}"
            >
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchHistoryCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
            <Image
              Width="20"
              Height="20"
              Margin="0,0,8,0"
              HorizontalAlignment="Right"
              IsHitTestVisible="False"
              Source="{SvgImage /Assets/Images/history/search.svg}"
            />
          </Grid>
          <ComboBox
            x:Name="HistoryStimulusFilter"
            Grid.Column="2"
            Theme="{StaticResource HistoryComboBoxTheme}"
            ItemContainerTheme="{StaticResource HistoryComboBoxItemTheme}"
            ItemsSource="{Binding HistoryStimulusFilters}"
            SelectedItem="{Binding SelectedHistoryStimulusFilter, Mode=TwoWay}"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:HistoryStimulusFilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="pages:HistoryStimulusFilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <ComboBox
            x:Name="HistoryStatusFilter"
            Grid.Column="4"
            Theme="{StaticResource HistoryComboBoxTheme}"
            ItemContainerTheme="{StaticResource HistoryComboBoxItemTheme}"
            ItemsSource="{Binding HistoryRunStatusFilters}"
            SelectedItem="{Binding SelectedHistoryRunStatusFilter, Mode=TwoWay}"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:HistoryRunStatusFilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="pages:HistoryRunStatusFilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Border
            Grid.Column="6"
            BorderBrush="{DynamicResource ProductStimulusInputBorder}"
            BorderThickness="1"
            CornerRadius="4"
            ToolTip.Tip="计划日期（包含起止日）"
          >
            <Grid Margin="1,0,0,0" ColumnDefinitions="*,18,*">
              <controls:DateSelectionPicker
                x:Name="HistoryStartDatePicker"
                Theme="{StaticResource HistoryDatePickerTheme}"
                SelectedDate="{Binding HistoryStartDate, Mode=TwoWay}"
              />
              <TextBlock
                Grid.Column="1"
                Text="～"
                Classes="history-muted"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
              />
              <controls:DateSelectionPicker
                x:Name="HistoryEndDatePicker"
                Grid.Column="2"
                Theme="{StaticResource HistoryDatePickerTheme}"
                SelectedDate="{Binding HistoryEndDate, Mode=TwoWay}"
              />
            </Grid>
          </Border>
          <Button
            Grid.Column="8"
            Classes="history-action history-primary"
            Command="{Binding SearchHistoryCommand}"
            Theme="{StaticResource ExperimentButtonTheme}"
          >
            <TextBlock Text="查询"/>
          </Button>
          <Button
            Grid.Column="10"
            Classes="history-action"
            Command="{Binding ResetHistoryFiltersCommand}"
            Theme="{StaticResource ExperimentButtonTheme}"
          >
            <TextBlock Text="重置"/>
          </Button>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox
                Theme="{StaticResource HistoryCheckBoxTheme}"
                Content="全选本页"
                IsThreeState="True"
                IsChecked="{Binding HistoryPageSelectionState, Mode=OneWay}"
                Command="{Binding ToggleCurrentPageHistorySelectionCommand}"
                IsEnabled="{Binding IsHistoryInteractionEnabled}"
                IsVisible="{Binding HasHistoryResults}"
                ToolTip.Tip="选择或取消当前页的全部运行记录"
              />
              <TextBlock
                Text="{Binding HistoryStatusText}"
                Classes="history-muted"
                IsVisible="{Binding !HasHistoryValidationError}"
                VerticalAlignment="Center"
              />
            </StackPanel>
            <TextBlock
              Text="{Binding HistoryValidationText}"
              Classes="history-error"
              IsVisible="{Binding HasHistoryValidationError}"
            />
            <TextBlock
              IsVisible="{Binding BatchExportStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding BatchExportStatusText}"
              Classes="history-success"
              TextTrimming="CharacterEllipsis"
            />
            <TextBlock
              IsVisible="{Binding BatchDeleteStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding BatchDeleteStatusText}"
              Classes="history-error"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Top">
            <TextBlock
              Text="{Binding HistorySelectionText}"
              Classes="history-muted"
              VerticalAlignment="Center"
            />
            <Button
              Classes="history-action history-primary"
              Command="{Binding BatchExportHistoryCommand}"
              Theme="{StaticResource ExperimentButtonTheme}"
            >
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/history/export.svg}"/>
                <TextBlock Text="批量导出…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button
              Classes="history-action history-danger"
              Command="{Binding BatchDeleteHistoryCommand}"
              Theme="{StaticResource ExperimentButtonTheme}"
            >
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/history/delete.svg}"/>
                <TextBlock Text="批量删除" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button
              Classes="history-action"
              IsEnabled="{Binding IsHistoryInteractionEnabled}"
              Command="{Binding RefreshHistoryCommand}"
              Theme="{StaticResource ExperimentButtonTheme}"
            >
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/history/refresh.svg}"/>
                <TextBlock Text="刷新" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer
          x:Name="HistoryTableScroll"
          Grid.Row="4"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled"
        >
          <Grid Width="{Binding #HistoryTableScroll.Viewport.Width}" MinWidth="1240" RowDefinitions="52,8,*">
            <!-- These columns are also used by every record, including wrapped point tags. -->
            <Border Classes="history-table-header">
              <Grid x:Name="HistoryTableHeader" ColumnDefinitions="200,0.85*,1.05*,100,1.55*,94,1.65*,200">
                <TextBlock
                  Grid.Column="0"
                  Text="实验ID"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="被试ID"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="2"
                  Text="刺激配置方案"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="3"
                  Text="刺激电流"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="4"
                  Text="选中点位"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="5"
                  Text="实验次数"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="6"
                  Text="计划时间"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
                <TextBlock
                  Grid.Column="7"
                  Text="操作"
                  Margin="16,0"
                  VerticalAlignment="Center"
                  Classes="history-muted"
                  FontWeight="Medium"
                />
              </Grid>
            </Border>
            <ScrollViewer
              Grid.Row="2"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              IsEnabled="{Binding IsHistoryInteractionEnabled}"
            >
              <ItemsControl ItemsSource="{Binding HistoryRecords}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:ExperimentHistoryRecordViewModel">
                    <Border Classes="history-group">
                      <Grid RowDefinitions="Auto,Auto">
                        <Border Classes="history-group-header">
                          <Grid MinHeight="52" ColumnDefinitions="200,0.85*,1.05*,100,1.55*,94,1.65*,200">
                            <Grid Margin="16,0" ColumnDefinitions="16,8,*">
                              <CheckBox
                                Theme="{StaticResource HistoryCheckBoxTheme}"
                                IsThreeState="True"
                                IsChecked="{Binding SelectionState, Mode=OneWay}"
                                Command="{Binding ToggleAllRunsCommand}"
                                ToolTip.Tip="选择或取消该实验的全部运行记录"
                              />
                              <TextBlock
                                Grid.Column="2"
                                Text="{Binding ExperimentId}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding ExperimentId}"
                                VerticalAlignment="Center"
                              />
                            </Grid>
                            <TextBlock
                              Grid.Column="1"
                              Margin="16,0"
                              Text="{Binding PatientId}"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding PatientId}"
                              VerticalAlignment="Center"
                            />
                            <TextBlock
                              Grid.Column="2"
                              Margin="16,0"
                              Text="{Binding StimulationProtocol}"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding StimulationProtocol}"
                              VerticalAlignment="Center"
                            />
                            <TextBlock
                              Grid.Column="3"
                              Margin="16,0"
                              Text="{Binding StimulationCurrent}"
                              VerticalAlignment="Center"
                            />
                            <ItemsControl
                              Grid.Column="4"
                              Margin="16,8"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ElectrodePoints}"
                              ItemTemplate="{StaticResource HistoryElectrodePointTemplate}"
                            >
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock
                              Grid.Column="5"
                              Margin="16,0"
                              Text="{Binding ExperimentCount}"
                              Classes="history-count"
                              VerticalAlignment="Center"
                            />
                            <TextBlock
                              Grid.Column="6"
                              Margin="16,0"
                              Text="{Binding RecordedAt}"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding RecordedAt}"
                            />
                            <StackPanel
                              Grid.Column="7"
                              Margin="16,0"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center"
                            >
                              <Button
                                Width="80"
                                Classes="history-action"
                                Theme="{StaticResource ExperimentButtonTheme}"
                                Command="{Binding #Root.((pages:StartExperimentPageViewModel)DataContext).CopyHistoryConfigurationCommand}"
                                CommandParameter="{Binding}"
                              >
                                <TextBlock Text="复制配置"/>
                              </Button>
                              <Button
                                Width="80"
                                Classes="history-action"
                                Theme="{StaticResource ExperimentButtonTheme}"
                                Command="{Binding ToggleExpandedCommand}"
                                  IsVisible="{Binding IsDeviceExperiment}"
                              >
                                <TextBlock Text="运行记录"/>
                              </Button>
                                <Button Width="80" Classes="history-action" Theme="{StaticResource ExperimentButtonTheme}" IsVisible="{Binding IsSpeech}"
                                  Command="{Binding #Root.((pages:StartExperimentPageViewModel)DataContext).ViewHistoryResultCommand}" CommandParameter="{Binding AggregateRun}">
                                  <TextBlock Text="查看结果"/>
                                </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <controls:AnimatedExpander
                          x:Name="RunHistoryExpander"
                          Grid.Row="1"
                          IsExpanded="{Binding IsExpanded}"
                        >
                          <ItemsControl Margin="16,8,16,0" ItemsSource="{Binding Runs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="pages:ExperimentHistoryRunViewModel">
                                <Border Classes="history-child-row">
                                  <Grid MinHeight="42" ColumnDefinitions="24,2.25*,1.5*,1.5*,1.6*,Auto">
                                    <CheckBox
                                      Theme="{StaticResource HistoryCheckBoxTheme}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip.Tip="选择此运行记录"
                                    />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                      <Run Text="开始时刻："/>
                                      <Run Text="{Binding StartedAt}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                      <Run Text="结束方式："/>
                                      <Run Text="{Binding Status}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Margin="8,0" VerticalAlignment="Center">
                                      <Run Text="持续时间："/>
                                      <Run Text="{Binding Duration}"/>
                                    </TextBlock>
                                    <TextBlock
                                      Grid.Column="4"
                                      Margin="8,0"
                                      Text="{Binding PacketQuality}"
                                      VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{Binding PacketQuality}"
                                    />
                                    <Button
                                      Grid.Column="5"
                                      Padding="0"
                                      Theme="{StaticResource ExperimentButtonTheme}"
                                      Command="{Binding #Root.((pages:StartExperimentPageViewModel)DataContext).ViewHistoryResultCommand}"
                                      CommandParameter="{Binding}"
                                    >
                                      <TextBlock Text="查看结果" Classes="history-count"/>
                                    </Button>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </controls:AnimatedExpander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </ScrollViewer>
        <controls:HistoryPagination
          x:Name="HistoryPaginationBar"
          Grid.Row="6"
          IsEnabled="{Binding IsHistoryInteractionEnabled}"
          IsVisible="{Binding HasHistoryResults}"
          PageNumber="{Binding HistoryPageNumber}"
          PageSize="{Binding HistoryPageSize, Mode=TwoWay}"
          PageSizes="{Binding HistoryPageSizes}"
          TotalCount="{Binding HistoryTotalCount}"
          IsBusy="{Binding IsHistoryLoading}"
          PreviousCommand="{Binding PreviousHistoryPageCommand}"
          NextCommand="{Binding NextHistoryPageCommand}"
        />
      </Grid>
      <Grid Grid.Row="1" IsVisible="{Binding IsToleranceHistorySelected}"><views:ToleranceHistoryView DataContext="{Binding ToleranceHistory}"/></Grid>
    </Grid>
  </Border>
</UserControl>
