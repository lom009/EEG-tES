<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:Class="EGGtCSPlatform.Views.Pages.PhysicalChannelMappingPageView"
  x:DataType="pages:PhysicalChannelMappingPageViewModel"
  mc:Ignorable="d"
  d:DesignWidth="1440"
  d:DesignHeight="768"
>
  <Grid Margin="24" ColumnDefinitions="2*,24,*">
    <Border Background="White" CornerRadius="12">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="20,16,20,0" Spacing="4">
          <TextBlock
            FontFamily="{DynamicResource AlibabaPuHuiTi}"
            FontWeight="Bold"
            FontSize="{DynamicResource FontSize18}"
            Foreground="#232B38"
            Text="电极位置"
          />
          <TextBlock
            FontSize="{DynamicResource FontSize12}"
            Foreground="#7A8BA8"
            Text="点击脑图点位可定位右侧映射项；这里仅配置 EEG 采集通道 1～32。"
          />
        </StackPanel>
        <controls:ElectrodeHeadMap
          Grid.Row="1"
          Margin="0,-20,0,0"
          ItemsSource="{Binding Points}"
          PointCommand="{Binding SelectPointCommand}"
        />
      </Grid>
    </Border>

    <Border Grid.Column="2" Padding="16" Background="White" CornerRadius="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock
              FontFamily="{DynamicResource AlibabaPuHuiTi}"
              FontWeight="Bold"
              FontSize="{DynamicResource FontSize18}"
              Foreground="#232B38"
              Text="EEG采集物理通道映射"
            />
            <TextBlock
              FontSize="{DynamicResource FontSize12}"
              Foreground="#7A8BA8"
              Text="{Binding ChannelRangeText}"
            />
          </StackPanel>
          <Button
            Grid.Column="1"
            Height="34"
            Padding="16,0"
            Background="#4148C5"
            Command="{Binding SaveCommand}"
            Content="保存映射"
            Foreground="White"
            CornerRadius="6"
          />
        </Grid>

        <Border Grid.Row="1" Padding="10,7" Background="#F8FAFC" CornerRadius="6">
          <StackPanel Spacing="3">
            <TextBlock
              FontSize="{DynamicResource FontSize12}"
              Foreground="#64748B"
              Text="{Binding ValidationText}"
              TextWrapping="Wrap"
            />
            <TextBlock
              FontSize="{DynamicResource FontSize12}"
              Foreground="#2FA56A"
              Text="{Binding StatusText}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </Border>

        <ListBox
          Grid.Row="2"
          Background="White"
          BorderThickness="0"
          ItemsSource="{Binding Mappings}"
          SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
        >
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:pointerover">
              <Setter Property="Background" Value="#F1F5F9" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#EEF2FF" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pages:PhysicalChannelMappingItemViewModel">
              <Border Margin="0,0,0,6" Padding="12,8" Background="#F8FAFC" CornerRadius="6">
                <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock
                      FontFamily="{DynamicResource AlibabaPuHuiTi}"
                      FontWeight="Medium"
                      FontSize="{DynamicResource FontSize14}"
                      Text="{Binding PositionName}"
                    />
                    <TextBlock
                      FontSize="{DynamicResource FontSize10}"
                      Foreground="#8A98AD"
                      Text="{Binding ElectrodeId}"
                    />
                  </StackPanel>
                  <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  >
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="pages:PhysicalChannelOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.SelectionBoxItemTemplate>
                      <DataTemplate x:DataType="pages:PhysicalChannelOption">
                        <TextBlock Foreground="#232B38" Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock
          Grid.Row="3"
          HorizontalAlignment="Right"
          FontSize="{DynamicResource FontSize11}"
          Foreground="#7A8BA8"
          Text="未映射点位不会阻塞当前实验流程"
        />
      </Grid>
    </Border>
  </Grid>
</UserControl>
