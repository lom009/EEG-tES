<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  xmlns:views="clr-namespace:EGGtCSPlatform.Views.Pages"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  x:Class="EGGtCSPlatform.Views.Pages.EnvelopeStimulationPageView"
  x:DataType="pages:EnvelopeStimulationPageViewModel"
  FontFamily="{DynamicResource AlibabaPuHuiTi}"
  Foreground="{DynamicResource ProductText}"
  FontSize="14"
>
  <UserControl.Resources>
    <!-- Original 20×20 icon paths from the speech-training design SVG. -->
    <StreamGeometry x:Key="SpeechReplayIcon">
      M 16.16 2.634 L 17.34 3.812 L 15.27 5.875 L 17.34 7.937 L 15.27 10 L 17.34 12.063 L 15.27 14.126 L 17.34 16.188 L 16.16 17.367 L 12.92 14.125 L 14.98 12.063 L 12.92 10 L 14.98 7.937 L 12.92 5.875 L 16.16 2.634 Z M 10.74 3.116 C 10.8 3.19 10.83 3.283 10.83 3.379 V 16.621 C 10.83 16.7 10.81 16.777 10.77 16.844 C 10.73 16.911 10.67 16.964 10.6 16.998 C 10.52 17.031 10.44 17.044 10.37 17.035 C 10.29 17.025 10.21 16.993 10.15 16.943 L 5.74 13.332 L 2.5 13.333 C 2.28 13.333 2.07 13.246 1.91 13.089 C 1.75 12.933 1.67 12.721 1.67 12.5 V 7.5 C 1.67 7.279 1.75 7.067 1.91 6.911 C 2.07 6.754 2.28 6.667 2.5 6.667 H 5.74 L 10.15 3.057 C 10.2 3.022 10.24 2.996 10.3 2.98 C 10.35 2.964 10.4 2.959 10.46 2.964 C 10.51 2.97 10.57 2.986 10.61 3.012 C 10.66 3.037 10.7 3.073 10.74 3.115 V 3.116 Z M 9.17 6.017 L 6.34 8.332 H 3.33 V 11.667 L 6.34 11.666 L 9.17 13.982 V 6.017 Z
    </StreamGeometry>
    <StreamGeometry x:Key="SpeechSaveNextIcon">
      M 9.67 11.467 L 10.84 12.643 L 17.9 5.588 L 19.08 6.767 L 10.84 15 L 5.54 9.697 L 6.72 8.518 L 8.49 10.289 L 9.67 11.466 V 11.467 Z M 9.67 9.11 L 13.8 4.982 L 14.97 6.157 L 10.84 10.285 L 9.67 9.11 Z M 7.31 13.822 L 6.14 15 L 0.83 9.697 L 2.01 8.518 L 3.19 9.696 L 3.19 9.697 L 7.31 13.822 V 13.822 Z
    </StreamGeometry>
    <StreamGeometry x:Key="SpeechEndIcon">
      M 14.58 2.083 L 19.17 10 L 14.58 17.917 H 5.42 L 0.83 10 L 5.42 2.083 H 14.58 Z M 13.62 3.75 H 6.38 L 2.76 10 L 6.38 16.25 H 13.62 L 17.24 10 L 13.62 3.75 Z M 9.17 12.5 H 10.83 V 14.167 H 9.17 V 12.5 Z M 9.17 5.833 H 10.83 V 10.833 H 9.17 V 5.833 Z
    </StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="/Views/Pages/SpeechTrainingStyles.axaml" />
  </UserControl.Styles>
  <Grid Margin="24,0,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2.45*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" MinWidth="340" />
    </Grid.ColumnDefinitions>
    <!-- Keep the audio area below the header while the right panel uses the full page height. -->
    <ScrollViewer x:Name="TrainingScroll" Margin="0,44,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="card" MinHeight="700">
        <Grid RowDefinitions="Auto,14,350,16,Auto,12,Auto,12,*,10,Auto">
          <Grid x:Name="AudioHeader" ColumnDefinitions="*,16,Auto" RowDefinitions="Auto,0,Auto" SizeChanged="OnAudioHeaderSizeChanged">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Classes="heading" Text="音频执行" Margin="0,0,12,0" />
              <Border Background="{DynamicResource ProductStimulusTile}" CornerRadius="12" Padding="9,3">
                <TextBlock Text="ⓘ  题目音频可重复播放" FontSize="12" />
              </Border>
            </WrapPanel>
            <Grid x:Name="AudioVolumeControls" Grid.Column="2" Width="497" ColumnDefinitions="*,16,146" VerticalAlignment="Center">
              <Border x:Name="VolumeCapsule" Height="32" Background="#F5F7FA" CornerRadius="16" Padding="16,4">
                <Grid ColumnDefinitions="20,9,Auto,4,*,4,Auto">
                  <Button x:Name="MuteVolumeButton" Theme="{StaticResource StimulusFlatButtonTheme}"
                          Width="20" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                          Background="Transparent" BorderThickness="0" Command="{Binding ToggleMuteCommand}"
                          ToolTip.Tip="{Binding MuteActionText}" AutomationProperties.Name="{Binding MuteActionText}">
                    <Grid>
                      <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/envelope-training/volume-mute.svg}" IsVisible="{Binding IsMuted}" />
                      <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/envelope-training/volume-speaker.svg}" IsVisible="{Binding !IsMuted}" />
                    </Grid>
                  </Button>
                  <TextBlock Grid.Column="2" Text="0" Classes="muted" FontSize="12" />
                  <Slider
                    x:Name="VolumeSlider"
                    Classes="compact"
                    Grid.Column="4"
                    MinWidth="60"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    SmallChange="1"
                    LargeChange="10"
                    Theme="{StaticResource StimulusSliderTheme}"
                    Foreground="{DynamicResource ProductPrimary}"
                    Background="{DynamicResource ProductStimulusInputBorder}"
                    Value="{Binding VolumePercent, Mode=TwoWay}"
                    IsEnabled="{Binding CanAdjustVolume}"
                    ToolTip.Tip="{Binding VolumeText}"
                    AutomationProperties.Name="音量"
                    VerticalAlignment="Center"
                  />
                  <TextBlock Grid.Column="6" Text="100" Classes="muted" FontSize="12" />
                </Grid>
              </Border>
              <Border x:Name="PlaybackTimeBadge" Grid.Column="2" Height="32" Background="#F5F7FA" CornerRadius="16" Padding="14,6">
                <TextBlock Text="{Binding PlaybackText}" FontSize="13" />
              </Border>
            </Grid>
          </Grid>
          <Grid Grid.Row="2" x:Name="SpeechWaveformPanel">
            <Grid Margin="1" RowDefinitions="*,*,38">
              <!-- Grid and axes stay visible; only cached curve layers are revealed. -->
              <Border x:Name="VoiceZoomRegion" Background="White" CornerRadius="11,11,0,0" PointerWheelChanged="OnVoiceWheelChanged">
                <Grid Margin="14,0,2,0" ColumnDefinitions="22,*">
                  <TextBlock Text="语&#10;音&#10;包&#10;络" FontSize="12" LineHeight="22" />
                  <Grid Grid.Column="1">
                    <TextBlock
                      Text="Amplitude"
                      Foreground="#A9BAD4"
                      FontSize="10"
                      Margin="0,5,0,0"
                      VerticalAlignment="Top"
                    />
                    <Grid Margin="46,24,18,12" ColumnDefinitions="0,*">
                      <controls:WaveformPlotSurface x:Name="VoiceGrid" Grid.Column="1" GridColumns="8" GridRows="4" IsHitTestVisible="False" />
                      <controls:SpeechWaveformReveal Grid.Column="1"
                          RealtimeEnabled="{Binding EnvelopeWaveformRealtimeEnabled}"
                          Progress="{Binding PlaybackProgress}" TimelineAnimation="{Binding TimelineAnimation}">
                        <controls:SpeechWaveformCache Source="{Binding VoiceSamples}" SecondarySource="{Binding VoiceEnvelope}"
                            Duration="{Binding DisplayDurationSeconds}" Amplitude="{Binding VoiceMaximumAmplitude}">
                          <Grid>
                            <controls:WaveformPlotSurface
                              Samples="{Binding VoiceSamples}"
                              MaximumAmplitude="{Binding VoiceMaximumAmplitude}"
                              MinimumAmplitude="0.001"
                              GridBrush="Transparent"
                              GridColumns="8"
                              GridRows="4"
                              ViewEnd="{Binding DisplayDurationSeconds}"
                              WaveformBrush="#78C5FB"
                              WaveformStrokeThickness="0.8"
                              ClipToBounds="True"
                              IsHitTestVisible="False"
                            />
                            <controls:WaveformPlotSurface
                              Samples="{Binding VoiceEnvelope}"
                              MaximumAmplitude="{Binding VoiceMaximumAmplitude}"
                              MinimumAmplitude="0.001"
                              GridColumns="8"
                              GridRows="4"
                              ViewEnd="{Binding DisplayDurationSeconds}"
                              WaveformBrush="#FF704D"
                              WaveformStrokeThickness="1.2"
                              GridBrush="Transparent"
                              ClipToBounds="True"
                              IsHitTestVisible="False"
                            />
                          </Grid>
                        </controls:SpeechWaveformCache>
                      </controls:SpeechWaveformReveal>
                    </Grid>
                    <controls:SpeechTrainingAmplitudeAxis MaximumAmplitude="{Binding VoiceMaximumAmplitude}" IsHitTestVisible="False" />
                  </Grid>
                </Grid>
              </Border>
              <Border
                x:Name="StimulusZoomRegion"
                PointerWheelChanged="OnStimulusWheelChanged"
                Grid.Row="1"
                Background="#F8FAFD"
                BorderBrush="#E6EBF4"
                BorderThickness="0,1,0,0"
              >
                <Grid Margin="14,0,2,0" ColumnDefinitions="22,*">
                  <TextBlock Text="刺&#10;激&#10;预&#10;览" FontSize="12" LineHeight="22" />
                  <controls:WaveformPlotSurface Grid.Column="1" Margin="46,24,18,12"
                      GridColumns="8" GridRows="4" GridBrush="#E2E8F2" IsHitTestVisible="False" />
                  <controls:SpeechWaveformReveal Grid.Column="1" Margin="46,24,18,12"
                      RealtimeEnabled="{Binding EnvelopeWaveformRealtimeEnabled}"
                      Progress="{Binding PlaybackProgress}" TimelineAnimation="{Binding TimelineAnimation}">
                    <controls:SpeechWaveformCache Source="{Binding StimulusPreview}"
                        Duration="{Binding DisplayDurationSeconds}" Amplitude="{Binding StimulusMaximumAmplitude}"
                        Current="{Binding PreviewCurrentScale}" Delay="{Binding DelayMilliseconds}">
                      <controls:SpeechStimulusPreviewControl
                        DrawAxes="False"
                        MaximumAmplitude="{Binding StimulusMaximumAmplitude}"
                        Preview="{Binding StimulusPreview}"
                        DurationSeconds="{Binding DisplayDurationSeconds}"
                        MaximumCurrent="{Binding PreviewCurrentScale}"
                        DelayMilliseconds="{Binding DelayMilliseconds}"
                      />
                    </controls:SpeechWaveformCache>
                  </controls:SpeechWaveformReveal>
                  <!-- Axes sit above the cached curve layer, so the zero line cannot obscure ticks. -->
                  <controls:SpeechStimulusPreviewControl
                    Grid.Column="1"
                    MaximumAmplitude="{Binding StimulusMaximumAmplitude}"
                    DrawCurves="False" DrawGrid="False" IsHitTestVisible="False"
                    Preview="{Binding StimulusPreview}"
                    DurationSeconds="{Binding DisplayDurationSeconds}"
                    MaximumCurrent="{Binding PreviewCurrentScale}"
                    DelayMilliseconds="{Binding DelayMilliseconds}"
                  />
                </Grid>
              </Border>
              <Border
                Grid.Row="2"
                Background="White"
                CornerRadius="0,0,11,11"
                BorderBrush="#E6EBF4"
                BorderThickness="0,1,0,0"
              >
                <Grid>
                  <TextBlock
                    Text="时间(s)"
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    Foreground="#A9BAD4"
                    FontSize="10"
                  />
                  <controls:SpeechTrainingTimeAxis
                    x:Name="SpeechTimeAxis"
                    DurationSeconds="{Binding DisplayDurationSeconds}"
                    Margin="36,0,2,0"
                  />
                </Grid>
              </Border>
              <controls:SpeechTrainingPlayhead
                Grid.RowSpan="2"
                Margin="82,24,20,12"
                Progress="{Binding PlaybackProgress}"
                TimelineAnimation="{Binding TimelineAnimation}"
                IsVisible="{Binding ShowPlaybackPlayhead}"
                IsHitTestVisible="False"
              />
            </Grid>
            <Border
              BorderBrush="#DCE5F4"
              BorderThickness="1"
              CornerRadius="12"
              IsHitTestVisible="False"
            />
          </Grid>
          <Grid Grid.Row="4" ColumnDefinitions="Auto,12,*,Auto">
            <TextBlock Classes="heading" Text="言语训练" />
            <WrapPanel Grid.Column="2" Orientation="Horizontal">
              <Border Background="{DynamicResource ProductStimulusTile}" CornerRadius="12" Padding="8,3" Margin="0,0,10,4">
                <TextBlock Text="{Binding CorpusLabel}" FontSize="11" />
              </Border>
              <Border Background="{DynamicResource ProductTrainingAttentionSurface}" CornerRadius="12" Padding="8,3" Margin="0,0,0,4">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ProductTrainingAttention}" FontSize="12" />
              </Border>
            </WrapPanel>
            <TextBlock Grid.Column="3" Text="{Binding SentencePosition}" Margin="6,0,0,0" />
          </Grid>
          <UniformGrid Grid.Row="6" Columns="4">
            <Border Background="{DynamicResource ProductStimulusTile}" Padding="10" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Image Width="18" Height="18" Source="{SvgImage /Assets/Images/envelope-training/flag.svg}" /><TextBlock Text="已评" Classes="muted" />
                <TextBlock Text="{Binding RatedText}" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource ProductStimulusTile}" Padding="10" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Image Width="18" Height="18" Source="{SvgImage /Assets/Images/envelope-training/correct-action.svg}" /><TextBlock Text="正确" Classes="muted" />
                <TextBlock Text="{Binding CorrectCount}" Foreground="{DynamicResource ProductExcellent}" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource ProductStimulusTile}" Padding="10" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Image Width="18" Height="18" Source="{SvgImage /Assets/Images/envelope-training/wrong-action.svg}" /><TextBlock Text="错误" Classes="muted" />
                <TextBlock Text="{Binding WrongCount}" Foreground="{DynamicResource ProductFeedbackError}" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource ProductStimulusTile}" Padding="10">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Image Width="18" Height="18" Source="{SvgImage /Assets/Images/envelope-training/pie.svg}" /><TextBlock Text="正确率" Classes="muted" />
                <TextBlock Text="{Binding AccuracyText}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <ItemsControl Grid.Row="8" ItemsSource="{Binding Words}" MinHeight="140">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:SpeechWordViewModel">
                <Border
                  Margin="3,3,10,7"
                  Background="White"
                  CornerRadius="9"
                  BorderBrush="#E3E7F3"
                  BorderThickness="1"
                  BoxShadow="0 4 10 0 #333941B6"
                  Padding="6,16,6,14"
                >
                  <Grid RowDefinitions="*,Auto">
                    <Border
                      BorderBrush="{Binding Accent}"
                      BorderThickness="0,2,0,0"
                      CornerRadius="8"
                      Margin="-6,-16,-6,0"
                      VerticalAlignment="Top"
                      Height="5"
                    />
                    <TextBlock
                      Text="{Binding Text}"
                      FontSize="24"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                    />
                    <controls:SpeechScoreButtonsPanel Grid.Row="1" Margin="0,14,0,0">
                      <Button
                        Classes="speech-score"
                        Command="{Binding WrongCommand}"
                        Foreground="{Binding WrongColor}"
                        ToolTip.Tip="错误"
                      >
                        <Viewbox Stretch="Uniform">
                          <Grid Width="40" Height="40">
                            <Image Classes="scoreDisabled" Width="16" Height="16" Source="{SvgImage /Assets/Images/envelope-training/wrong.svg}" />
                            <Grid Classes="scoreEnabled">
                              <Image Width="16" Height="16" IsVisible="{Binding !IsIncorrectScore}" Source="{SvgImage /Assets/Images/envelope-training/wrong-enabled.svg}" />
                              <Image Width="16" Height="16" IsVisible="{Binding IsIncorrectScore}" Source="{SvgImage /Assets/Images/envelope-training/wrong-selected.svg}" />
                            </Grid>
                          </Grid>
                        </Viewbox>
                      </Button>
                      <Button
                        Classes="speech-score"
                        Command="{Binding CorrectCommand}"
                        Foreground="{Binding CorrectColor}"
                        ToolTip.Tip="正确"
                      >
                        <Viewbox Stretch="Uniform">
                          <Grid Width="40" Height="40">
                            <Image Classes="scoreDisabled" Width="16" Height="16" Source="{SvgImage /Assets/Images/envelope-training/correct.svg}" />
                            <Grid Classes="scoreEnabled">
                              <Image Width="16" Height="16" IsVisible="{Binding !IsCorrectScore}" Source="{SvgImage /Assets/Images/envelope-training/correct-enabled.svg}" />
                              <Image Width="16" Height="16" IsVisible="{Binding IsCorrectScore}" Source="{SvgImage /Assets/Images/envelope-training/correct-selected.svg}" />
                            </Grid>
                          </Grid>
                        </Viewbox>
                      </Button>
                    </controls:SpeechScoreButtonsPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Row="10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel IsVisible="{Binding ShowResponseAssistance}" Spacing="5">
              <WrapPanel Orientation="Horizontal">
                <Button
                  Content="开始录音"
                  IsVisible="{Binding !IsResponseRecording}"
                  Command="{Binding StartResponseCommand}"
                />
                <Button
                  Content="结束并初判"
                  IsVisible="{Binding IsResponseRecording}"
                  Command="{Binding SubmitResponseCommand}"
                />
                <Button
                  Content="回听录音"
                  Margin="8,0,0,0"
                  IsVisible="{Binding HasResponseAudio}"
                  Command="{Binding ReplayResponseCommand}"
                />
              </WrapPanel>
              <TextBlock
                Text="{Binding ResponseStatus}"
                Classes="muted"
                FontSize="12"
                TextWrapping="Wrap"
              />
            </StackPanel>
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              Spacing="12"
            >
              <Button Content="✓  全对" Command="{Binding AllCorrectCommand}" />
              <Button Content="×  全错" Command="{Binding AllWrongCommand}" />
              <Button Content="⟲  重置" Command="{Binding ResetCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </ScrollViewer>
    <Border x:Name="TrainingSettingsPanel" Grid.Column="2" Classes="card" Padding="16,20,16,20">
      <Grid RowDefinitions="Auto,18,*,Auto">
        <StackPanel Spacing="12">
          <TextBlock Classes="heading" Text="包络-tACS 刺激方案" />
          <Border Classes="soft">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,10,Auto">
              <TextBlock Text="最大电流：" Classes="muted" />
              <TextBlock Grid.Column="1" Text="{Binding CurrentText}" />
              <TextBlock Grid.Row="2" Text="点位：" Classes="muted" />
              <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding Electrodes}"
                TextWrapping="Wrap"
                FontSize="12"
              />
            </Grid>
          </Border>
        </StackPanel>
        <ScrollViewer
          x:Name="TrainingSettingsScroll"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          IsScrollChainingEnabled="False"
        >
          <StackPanel Spacing="18" Margin="0,0,12,0">
            <Border Height="1" Background="#D8DFEA" />
            <TextBlock Classes="heading" Text="训练设置" />
            <StackPanel x:Name="CorpusSettingsSection" Spacing="10">
              <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,12,Auto,12,Auto">
                <TextBlock Text="语料库" />
                <ComboBox
                  Classes="speech-field"
                  IsEnabled="{Binding CanConfigure}"
                  x:Name="CorpusSelector"
                  Grid.Column="1"
                  ItemsSource="{Binding CorpusOptions}"
                  SelectedItem="{Binding SelectedCorpus}"
                />
                <TextBlock Grid.Row="2" Text="每表句数" />
                <ComboBox
                  x:Name="ListSizeSelector"
                  Classes="speech-field"
                  Grid.Row="2"
                  Grid.Column="1"
                  IsEnabled="{Binding CanConfigure}"
                  ItemsSource="{Binding ListSizeOptions}"
                  SelectedItem="{Binding ListSize}"
                />
                <TextBlock Grid.Row="4" Text="句表号" />
                <ComboBox
                  Classes="speech-field"
                  IsEnabled="{Binding CanConfigure}"
                  Grid.Row="4"
                  Grid.Column="1"
                  ItemsSource="{Binding SentenceListOptions}"
                  SelectedItem="{Binding SentenceList}"
                />
              </Grid>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="测试模式" />
                <ComboBox
                  Classes="speech-field"
                  IsEnabled="{Binding CanConfigure}"
                  x:Name="ModeSelector"
                  Grid.Column="1"
                  ItemsSource="{Binding ModeOptions}"
                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                />
              </Grid>
            </StackPanel>
            <StackPanel x:Name="CarrierSettingsSection" Spacing="10">
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="载体" />
                <ComboBox
                  Classes="speech-field"
                  IsEnabled="{Binding CanAdjustCarrier}"
                  x:Name="CarrierSelector"
                  Grid.Column="1"
                  ItemsSource="{Binding CarrierOptions}"
                  SelectedItem="{Binding SelectedCarrier, Mode=TwoWay}"
                />
              </Grid>
              <StackPanel IsVisible="{Binding IsVocoderEnabled}" Spacing="10">
                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,10,Auto,10,Auto">
                  <TextBlock Text="声码算法" />
                  <ComboBox IsEnabled="{Binding CanAdjustCarrier}" x:Name="VocoderAlgorithmSelector" Grid.Column="1" Classes="speech-field" ItemsSource="{Binding VocoderAlgorithms}" SelectedItem="{Binding VocoderAlgorithm, Mode=TwoWay}" />
                  <TextBlock Grid.Row="2" Text="频带数" />
                  <controls:StimulusNumericInput IsEnabled="{Binding CanAdjustCarrier}" x:Name="VocoderBandsInput" Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="22" Increment="1" DecimalPlaces="0" Value="{Binding VocoderBands, Mode=TwoWay}" AutomationProperties.Name="声码器频带数" />
                  <TextBlock Grid.Row="4" Text="声学载波" />
                  <ComboBox IsEnabled="{Binding CanAdjustCarrier}" x:Name="VocoderCarrierSelector" Grid.Row="4" Grid.Column="1" Classes="speech-field" ItemsSource="{Binding VocoderCarriers}" SelectedItem="{Binding VocoderCarrier, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="72,*" IsVisible="{Binding ShowVocoderMaxima}">
                  <TextBlock Text="激活通道" />
                  <controls:StimulusNumericInput IsEnabled="{Binding CanAdjustCarrier}" x:Name="VocoderMaximaInput" Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False" Grid.Column="1" Minimum="1" Maximum="{Binding VocoderBands}" Increment="1" DecimalPlaces="0" Value="{Binding VocoderMaxima, Mode=TwoWay}" AutomationProperties.Name="最大激活通道数" />
                </Grid>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ModeSettingsSection" Spacing="10">
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{Binding RateLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding RirConditionText}" IsVisible="{Binding IsRirMode}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" x:Name="SnrInfo" Text="{Binding SnrText}" IsVisible="{Binding IsSnrMode}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" x:Name="AdaptiveRateInfo" Text="{Binding AdaptiveRateText}" IsVisible="{Binding IsAdaptiveMode}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,4,*,4,Auto,12,72" IsVisible="{Binding IsFixedMode}">
                  <TextBlock Text="0" Classes="muted" FontSize="12" />
                  <Slider IsEnabled="{Binding CanAdjustSpeechRate}" x:Name="SpeechRateSlider" Grid.Column="2"
                          Minimum="0" Maximum="5" TickFrequency="1" SmallChange="1" LargeChange="1"
                          IsSnapToTickEnabled="True" Theme="{StaticResource StimulusSliderTheme}"
                          Foreground="{DynamicResource ProductPrimary}" Background="{DynamicResource ProductStimulusInputBorder}"
                          Value="{Binding SpeechRate, Mode=TwoWay}" AutomationProperties.Name="语速" />
                  <TextBlock Grid.Column="4" Text="5" Classes="muted" FontSize="12" />
                  <controls:StimulusNumericInput IsEnabled="{Binding CanAdjustSpeechRate}" x:Name="SpeechRateInput" Grid.Column="6"
                      Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False"
                      Minimum="0" Maximum="5" Increment="1" DecimalPlaces="0" Unit="字/s"
                      Value="{Binding SpeechRate, Mode=TwoWay}"
                      AutomationProperties.Name="语速数值" />
                </Grid>
              </Grid>
              <StackPanel x:Name="DelaySettingsSection" Spacing="10">
                <Grid ColumnDefinitions="72,*">
                  <TextBlock Text="延时" />
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,4,*,4,Auto,12,72">
                    <TextBlock Text="0" Classes="muted" FontSize="12" />
                    <Slider IsEnabled="{Binding CanAdjustStimulation}" x:Name="DelaySlider" Grid.Column="2"
                            Minimum="0" Maximum="300" TickFrequency="1" SmallChange="1" LargeChange="1"
                            IsSnapToTickEnabled="True" Theme="{StaticResource StimulusSliderTheme}"
                            Foreground="{DynamicResource ProductPrimary}" Background="{DynamicResource ProductStimulusInputBorder}"
                            Value="{Binding DelayMilliseconds, Mode=TwoWay}" AutomationProperties.Name="延时" />
                    <TextBlock Grid.Column="4" Text="300" Classes="muted" FontSize="12" />
                    <controls:StimulusNumericInput IsEnabled="{Binding CanAdjustStimulation}" x:Name="DelayInput" Grid.Column="6"
                        Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False"
                        Minimum="0" Maximum="300" Increment="1" DecimalPlaces="0" Unit="ms"
                        Value="{Binding DelayMilliseconds, Mode=TwoWay}"
                        AutomationProperties.Name="延时数值" />
                  </Grid>
                </Grid>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsSnrMode}" Spacing="10">
                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,10,Auto">
                  <TextBlock Text="{Binding SnrInputLabel}" />
                  <controls:StimulusNumericInput IsEnabled="{Binding CanConfigure}" x:Name="InitialSnrInput" IsVisible="{Binding IsAdaptiveSnrMode}" Grid.Column="1" Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False" Minimum="0" Maximum="20" Increment="1" DecimalPlaces="2" Unit="dB" Value="{Binding InitialSnrDb, Mode=TwoWay}" AutomationProperties.Name="初始信噪比" />
                  <controls:StimulusNumericInput IsEnabled="{Binding CanConfigure}" x:Name="FixedSnrInput" IsVisible="{Binding IsFixedSnrMode}" Grid.Column="1" Height="32" Padding="8,0" CornerRadius="6" ShowButtonSpinner="False" AllowNegative="True" Minimum="{Binding FixedSnrMinimum}" Maximum="{Binding FixedSnrMaximum}" Increment="1" DecimalPlaces="2" Unit="dB" Value="{Binding FixedSnrDb, Mode=TwoWay}" AutomationProperties.Name="固定信噪比" />
                  <TextBlock Grid.Row="2" Text="背景噪声" />
                  <ComboBox IsEnabled="{Binding CanConfigure}" x:Name="NoiseSelector" Grid.Row="2" Grid.Column="1" Classes="speech-field" ItemsSource="{Binding NoiseOptions}" SelectedItem="{Binding SelectedNoise, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
              <views:SpeechRirSettingsView IsVisible="{Binding IsRirMode}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="14" Margin="0,32,0,0">
          <Button
            Classes="start"
            Content="开始播放音频并刺激  ▶"
            HorizontalAlignment="Stretch"
            IsVisible="{Binding CanConfigure}"
            Command="{Binding StartCommand}"
          />
          <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding ShowRunActions}">
            <Button
              x:Name="ReplayButton"
              Classes="speech-action"
              Content="重播"
              Tag="{StaticResource SpeechReplayIcon}"
              HorizontalAlignment="Stretch"
              Command="{Binding ReplayCommand}"
            />
            <Button
              Grid.Column="2"
              x:Name="SaveNextButton"
              Classes="primary speech-action"
              Content="下一句"
              Tag="{StaticResource SpeechSaveNextIcon}"
              HorizontalAlignment="Stretch"
              Command="{Binding SaveNextCommand}"
            />
          </Grid>
          <TextBlock Text="{Binding RoundCompletionText}" IsVisible="{Binding IsEnded}" Foreground="#31A46A" FontSize="12" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding IsEnded}">
            <Button Content="重播" IsEnabled="False" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" x:Name="AgainTrainingButton" Content="⟳  再来一次训练" Background="#32A269" Foreground="White"
                    CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AgainCommand}" />
          </Grid>
          <Button
            x:Name="EndTrainingButton"
            Classes="danger speech-action"
            Content="结束实验"
            Tag="{StaticResource SpeechEndIcon}"
            HorizontalAlignment="Stretch"
            Command="{Binding EndCommand}"
          />

        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
