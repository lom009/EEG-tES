<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  x:CompileBindings="False"
>
  <ControlTheme
    x:Key="{x:Type controls:StimulusOverviewCard}"
    TargetType="controls:StimulusOverviewCard"
  >
    <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
    <Setter Property="Padding" Value="22,18" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Padding="{TemplateBinding Padding}"
          Background="#80FFFFFF"
          BorderBrush="#FFFFFF"
          BorderThickness="1"
          BoxShadow="0 4 12 0 #17AE00B4"
          CornerRadius="8"
          ClipToBounds="False"
        >
          <StackPanel Spacing="3">
            <controls:StimulusWaveformControl
              Height="38"
              Descriptor="{TemplateBinding Descriptor}"
              DisplayMode="Compact"
            />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
              <TextBlock
                FontSize="{TemplateBinding FontSize}"
                Foreground="#9536F3"
                Text="{TemplateBinding CurrentLabel}"
                IsVisible="False"
              />
              <TextBlock
                FontSize="{TemplateBinding FontSize}"
                Foreground="#9536F3"
                Text="{TemplateBinding CurrentText}"
              />
            </StackPanel>
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="{TemplateBinding FontSize}"
              Foreground="#9536F3"
              Text="{TemplateBinding StatusText}"
            />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
