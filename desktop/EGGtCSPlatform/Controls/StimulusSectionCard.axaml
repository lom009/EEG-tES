<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:ClassModifier="internal"
  x:CompileBindings="False"
>
  <ControlTheme
    x:Key="{x:Type controls:StimulusSectionCard}"
    TargetType="controls:StimulusSectionCard"
  >
    <Setter Property="BorderBrush" Value="{DynamicResource ProductStimulusBorder}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Padding="15"
          Background="{DynamicResource ProductSurface}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="1"
          CornerRadius="6"
        >
          <Grid RowDefinitions="24,16,Auto">
            <TextBlock
              FontFamily="{DynamicResource AlibabaPuHuiTi}"
              FontWeight="SemiBold"
              FontSize="{DynamicResource FontSize16}"
              Foreground="{DynamicResource ProductText}"
              Text="{TemplateBinding Header}"
            />
            <ContentPresenter Grid.Row="2" Content="{TemplateBinding Content}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
