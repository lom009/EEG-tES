<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  xmlns:vm="clr-namespace:EGGtCSPlatform.ViewModels"
>
  <ControlTheme
    x:Key="{x:Type controls:ExperimentConfigurationDialog}"
    TargetType="controls:ExperimentConfigurationDialog"
  >
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
        <Border
          IsVisible="{TemplateBinding EnvelopeConfirmation, Converter={x:Static ObjectConverters.IsNotNull}}"
          Width="599"
          MinHeight="296"
          Padding="24"
          Background="White"
          BoxShadow="0 18 52 0 #550B1533"
          CornerRadius="8"
        >
          <Grid RowDefinitions="24,Auto,32" RowSpacing="16">
            <Grid ColumnDefinitions="*,24">
              <TextBlock Text="实验配置二次确认"
                         FontFamily="{DynamicResource AlibabaPuHuiTi}"
                         FontWeight="Bold" FontSize="18" Foreground="#232B38" />
              <Button Grid.Column="1" Width="24" Height="24" Padding="0"
                      Command="{TemplateBinding CloseCommand}"
                      Theme="{StaticResource ElectrodePointButtonTheme}">
                <Image Width="24" Height="24"
                       Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/close.svg}" />
              </Button>
            </Grid>
            <Border Grid.Row="1" MinHeight="160" Padding="15"
                    BorderBrush="#E8EFF7" BorderThickness="1" CornerRadius="4">
              <ContentControl Content="{TemplateBinding EnvelopeConfirmation}"
                              HorizontalContentAlignment="Stretch">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:EnvelopeConfirmationData">
                    <StackPanel Spacing="16">
                      <StackPanel.Styles>
                        <Style Selector="TextBlock">
                          <Setter Property="FontFamily" Value="{DynamicResource AlibabaPuHuiTi}" />
                          <Setter Property="FontSize" Value="14" />
                          <Setter Property="Foreground" Value="#232B38" />
                          <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                      </StackPanel.Styles>
                      <TextBlock><Run Foreground="#6B7D99" Text="刺激范式：" /><Run Text="包络-tACS · 单刺激" /></TextBlock>
                      <TextBlock><Run Foreground="#6B7D99" Text="最大电流：" /><Run Text="{Binding MaximumCurrent}" /></TextBlock>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBlock><Run Foreground="#6B7D99" Text="阳极：" /><Run Text="{Binding FixedChannel}" /></TextBlock>
                        <TextBlock Grid.Column="1"><Run Foreground="#6B7D99" Text="阴极：" /><Run Text="{Binding SelectableChannel}" /></TextBlock>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Border>
            <Button Grid.Row="2" Height="32" Background="#3941B6"
                    Command="{TemplateBinding ConfirmCommand}"
                    Theme="{StaticResource ConfirmationButtonTheme}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{SvgImage /Assets/Images/check-double-line.svg}" />
                <TextBlock Text="确认并进入言语训练" FontSize="14"
                           FontFamily="{DynamicResource AlibabaPuHuiTi}" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <!-- Figma 248:5312: native bindings with the original icon assets and slots. -->
        <Border
          IsVisible="{TemplateBinding EnvelopeConfirmation, Converter={x:Static ObjectConverters.IsNull}}"
          Width="800"
          Padding="24"
          Background="{DynamicResource ProductSurface}"
          BoxShadow="0 18 52 0 #550B1533"
          CornerRadius="8"
        >
          <Grid RowDefinitions="24,110,92,32" RowSpacing="16">
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AlibabaPuHuiTi}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource ProductText}" />
              </Style>
              <Style Selector="TextBlock.confirmation-section-title">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
              <Style Selector="Border.confirmation-card">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ProductStimulusBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
              </Style>
              <Style Selector="Border.confirmation-icon-tile">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="2.222" />
                <Setter Property="Background" Value="{DynamicResource ProductTrainingChip}" />
              </Style>
            </Grid.Styles>
            <Grid ColumnDefinitions="*,24">
              <TextBlock FontWeight="SemiBold" FontSize="18" Text="实验配置二次确认"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Width="24" Height="24" Padding="0"
                      Command="{TemplateBinding CloseCommand}"
                      Theme="{StaticResource ElectrodePointButtonTheme}">
                <Image x:Name="ConfirmationCloseIcon" Width="24" Height="24"
                       Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/close.svg}" />
              </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
              <Border Classes="confirmation-card">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                    <Image x:Name="ConfirmationPatientIcon" Width="20" Height="20"
                           Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/patient.svg}" />
                    <TextBlock Classes="confirmation-section-title" Text="患者与实验" />
                  </StackPanel>
                  <TextBlock>
                    <Run Foreground="{DynamicResource ProductTextMuted}" Text="患者ID：" />
                    <Run Text="{TemplateBinding SubjectId}" />
                  </TextBlock>
                  <TextBlock>
                    <Run Foreground="{DynamicResource ProductTextMuted}" Text="实验ID：" />
                    <Run Text="{TemplateBinding ExperimentId}" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="confirmation-card"
                      IsVisible="{TemplateBinding ShowStimulation}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8" Height="24">
                    <Border Classes="confirmation-icon-tile">
                      <Image x:Name="ConfirmationStimulationIcon" Width="15" Height="15"
                             Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/stimulation.svg}" />
                    </Border>
                    <TextBlock Classes="confirmation-section-title" Text="刺激方案" />
                  </StackPanel>
                  <TextBlock Text="{TemplateBinding StimulusSummary}" />
                  <TextBlock Text="{TemplateBinding ParameterSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
              <Border Classes="confirmation-card">
                <Grid RowDefinitions="24,8,*">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="confirmation-icon-tile">
                      <Image x:Name="ConfirmationAcquisitionIcon" Width="16" Height="16"
                             Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/acquisition.svg}" />
                    </Border>
                    <TextBlock Classes="confirmation-section-title" Text="电极与采集" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{TemplateBinding StimulusElectrodes}"
                                 IsVisible="{TemplateBinding ShowStimulation}" TextWrapping="Wrap" />
                      <TextBlock Text="{TemplateBinding AcquisitionElectrodes}"
                                 IsVisible="{TemplateBinding ShowAcquisition}" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="confirmation-card">
                <Grid RowDefinitions="24,8,*">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="confirmation-icon-tile">
                      <Image x:Name="ConfirmationSafetyIcon" Width="20" Height="20"
                             Source="{SvgImage /Assets/Images/Dialog/configuration-confirmation/safety.svg}" />
                    </Border>
                    <TextBlock Classes="confirmation-section-title" Text="安全校验" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="8">
                      <TextBlock><Run Foreground="{DynamicResource ProductTextMuted}" Text="患者耐受记录：" /><Run Text="-" /></TextBlock>
                      <TextBlock Text="{TemplateBinding SafetySummary}" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
            <Button Grid.Row="3" Height="32" Padding="12,6"
                    Background="{DynamicResource ProductPrimary}"
                    Command="{TemplateBinding ConfirmCommand}"
                    Theme="{StaticResource ConfirmationButtonTheme}">
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Image x:Name="ConfirmationConfirmIcon" Width="20" Height="20"
                       Source="{SvgImage /Assets/Images/check-double-line.svg}" />
                <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="White"
                           Text="确认参数配置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
