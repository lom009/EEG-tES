<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:CompileBindings="False"
>
  <ControlTheme
    x:Key="RunPageDangerButtonTheme"
    TargetType="Button"
    BasedOn="{StaticResource RunPagePrimaryButtonTheme}"
  >
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="#E91919" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize14}" />
  </ControlTheme>
</ResourceDictionary>
