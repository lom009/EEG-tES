<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:ClassModifier="internal"
  x:CompileBindings="False"
>
  <ControlTheme x:Key="StimulusSliderThumbTheme" TargetType="Thumb">
    <Setter Property="Width" Value="25.3333" />
    <Setter Property="Height" Value="25.3333" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Width="25.3333" Height="25.3333">
          <Border
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BoxShadow="0 0 3 0 #26051F48"
            CornerRadius="10"
          />
          <Image
            Width="25.3333"
            Height="25.3333"
            Source="{SvgImage /Assets/Images/stimulus-figma/slider-thumb.svg}"
          />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
