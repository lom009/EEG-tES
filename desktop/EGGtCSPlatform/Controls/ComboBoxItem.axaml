<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:ClassModifier="internal"
>
  <Design.PreviewWith>
    <Border Padding="20" Background="#F2F3F5">
      <Border
        Background="#FFFFFF"
        BorderBrush="#E4E7ED"
        BorderThickness="1"
        Padding="4"
        CornerRadius="4"
      >
        <StackPanel HorizontalAlignment="Stretch">
          <ComboBoxItem>Item 1</ComboBoxItem>
          <ComboBoxItem>Item 2 long</ComboBoxItem>
          <ComboBoxItem IsSelected="True">Item 3</ComboBoxItem>
          <ComboBoxItem IsEnabled="False">Item 4</ComboBoxItem>
          <ComboBoxItem IsSelected="True" IsEnabled="False">Item 5</ComboBoxItem>
        </StackPanel>
      </Border>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#606266" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize14}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="ItemSurface"
          MinHeight="{TemplateBinding MinHeight}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
        >
          <ContentPresenter
            Name="PART_ContentPresenter"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Foreground="{TemplateBinding Foreground}"
          />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Hover：轻微提亮，不抢夺已选状态的视觉层级。 -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#F5F7FA" />
      <Setter Property="Foreground" Value="#606266" />
    </Style>

    <!-- Pressed：提供明确但克制的点击反馈。 -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="#ECF5FF" />
      <Setter Property="Foreground" Value="#409EFF" />
    </Style>

    <!-- Selected：使用品牌色的浅色层，保持文字清晰。 -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#409EFF" />
      <Setter Property="FontFamily" Value="{DynamicResource AlibabaPuHuiTi}" />
    </Style>

    <Style Selector="^:selected:pointerover">
      <Setter Property="Background" Value="#F5F7FA" />
      <Setter Property="Foreground" Value="#409EFF" />
    </Style>

    <!-- Disabled：保留轮廓，同时降低信息权重。 -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#C0C4CC" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:selected:disabled">
      <Setter Property="Background" Value="#F5F7FA" />
      <Setter Property="Foreground" Value="#A0CFFF" />
    </Style>

    <!-- 从第二项开始绘制顶部分隔线，首项顶部和末项底部自然保持干净。 -->
    <Style Selector="^:nth-child(n+2)">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 首尾项的状态背景贴合下拉容器圆角。 -->
    <Style Selector="^:nth-child(1)">
      <Setter Property="CornerRadius" Value="4,4,0,0" />
    </Style>

    <Style Selector="^:nth-last-child(1)">
      <Setter Property="CornerRadius" Value="0,0,4,4" />
    </Style>

    <Style Selector="^:nth-child(1):nth-last-child(1)">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
