<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:ClassModifier="internal"
  x:CompileBindings="False"
>
  <ControlTheme x:Key="StimulusSliderTheme" TargetType="Slider">
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <ControlTemplate>
        <Track
          Name="PART_Track"
          Height="24"
          IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
          Maximum="{TemplateBinding Maximum}"
          Minimum="{TemplateBinding Minimum}"
          Orientation="Horizontal"
          Value="{TemplateBinding Value}"
        >
          <Track.DecreaseButton>
            <Button Name="ActiveTrack"
              Background="{TemplateBinding Foreground}"
              Theme="{StaticResource StimulusSliderTrackButtonTheme}"
            />
          </Track.DecreaseButton>
          <Track.IncreaseButton>
            <Button Name="InactiveTrack"
              Background="{TemplateBinding Background}"
              Theme="{StaticResource StimulusSliderTrackButtonTheme}"
            />
          </Track.IncreaseButton>
          <Track.Thumb>
            <Thumb ZIndex="1" Theme="{StaticResource StimulusSliderThumbTheme}" />
          </Track.Thumb>
        </Track>
      </ControlTemplate>
    </Setter>
    <!-- Half the 25.3333-wide thumb: both fills meet underneath its opaque center. -->
    <Style Selector="^ /template/ Button#ActiveTrack">
      <Setter Property="controls:SliderTrackAppearance.FillMargin" Value="0,0,-12.66665,0" />
    </Style>
    <Style Selector="^ /template/ Button#InactiveTrack">
      <Setter Property="controls:SliderTrackAppearance.FillMargin" Value="-12.66665,0,0,0" />
    </Style>
    <Style Selector="^[IsDirectionReversed=True] /template/ Button#ActiveTrack">
      <Setter Property="controls:SliderTrackAppearance.FillMargin" Value="-12.66665,0,0,0" />
    </Style>
    <Style Selector="^[IsDirectionReversed=True] /template/ Button#InactiveTrack">
      <Setter Property="controls:SliderTrackAppearance.FillMargin" Value="0,0,-12.66665,0" />
    </Style>
    <Style Selector="^.compact /template/ Button#ActiveTrack">
      <Setter Property="controls:SliderTrackAppearance.Height" Value="7" />
      <Setter Property="controls:SliderTrackAppearance.CornerRadius" Value="3.5" />
    </Style>
    <Style Selector="^.compact /template/ Button#InactiveTrack">
      <Setter Property="controls:SliderTrackAppearance.Height" Value="6" />
      <Setter Property="controls:SliderTrackAppearance.CornerRadius" Value="3" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
