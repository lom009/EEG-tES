<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:ClassModifier="internal"
  x:CompileBindings="False"
>
  <ControlTheme
    x:Key="{x:Type controls:StimulationChannelAllocationEditor}"
    TargetType="controls:StimulationChannelAllocationEditor"
  >
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="16,15" Background="{DynamicResource ProductStimulusTile}" CornerRadius="8">
          <Grid RowDefinitions="24,*">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="{DynamicResource AlibabaPuHuiTi}"
                FontWeight="Medium"
                FontSize="{DynamicResource FontSize14}"
                Foreground="{DynamicResource ProductText}"
                Text="HD 刺激物理通道配置"
              />
              <Border Padding="7,2" Background="{DynamicResource ProductStimulusBorder}" CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image
                    Width="14"
                    Height="14"
                    Source="{SvgImage /Assets/Images/stimulus-figma/info.svg}"
                  />
                  <TextBlock
                    FontSize="{DynamicResource FontSize11}"
                    Foreground="{DynamicResource ProductTextMuted}"
                    Text="自选刺激通道电流之和须等于峰值电流"
                  />
                </StackPanel>
              </Border>
              <Border
                x:Name="AllocationStatusBadge"
                Padding="6,0"
                Background="{DynamicResource ProductFeedbackSuccessSurface}"
                CornerRadius="999"
              >
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image
                    Width="16"
                    Height="16"
                    IsVisible="{Binding HasError, RelativeSource={RelativeSource TemplatedParent}}"
                    Source="{SvgImage /Assets/Images/stimulus-figma/status-circle.svg}"
                  />
                  <TextBlock
                    x:Name="AllocationStatusText"
                    MaxWidth="260"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AlibabaPuHuiTi}"
                    FontSize="{DynamicResource FontSize12}"
                    FontWeight="Medium"
                    Foreground="{DynamicResource ProductExcellent}"
                    Text="{TemplateBinding StatusText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{TemplateBinding StatusText}"
                  />
                </StackPanel>
              </Border>
            </StackPanel>
            <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{TemplateBinding ItemsSource}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" Rows="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <controls:StimulationChannelAllocationItem
                    Margin="0,5,12,0"
                    CanEditCurrent="{Binding CanEditCurrent}"
                    CanToggle="{Binding CanToggle}"
                    CommandParameter="{Binding}"
                    Label="{Binding DisplayName}"
                    Current="{Binding Current, Mode=TwoWay}"
                    CurrentIncrement="{Binding CurrentIncrement}"
                    MaximumCurrent="{Binding MaximumCurrent}"
                    MinimumCurrent="{Binding MinimumCurrent}"
                    IsChannelEnabled="{Binding Enabled, Mode=TwoWay}"
                    IsFixedCandidate="{Binding IsFixedActiveCandidate}"
                    IsSelectedFixed="{Binding IsSelectedFixed}"
                    RoleText="{Binding RoleText}"
                    SelectFixedCommand="{TemplateBinding SelectFixedCommand}"
                  />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:error /template/ Border#AllocationStatusBadge">
      <Setter Property="Background" Value="{DynamicResource ProductFeedbackErrorSurface}" />
    </Style>
    <Style Selector="^:error /template/ TextBlock#AllocationStatusText">
      <Setter Property="Foreground" Value="{DynamicResource ProductFeedbackError}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
