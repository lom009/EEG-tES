<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
  x:ClassModifier="internal"
  x:CompileBindings="False"
>
  <ControlTheme x:Key="StimulusSliderTrackButtonTheme" TargetType="Button">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Keep hit testing within the original button while extending only its paint. -->
        <Grid Background="Transparent">
        <Border
          Name="TrackFill"
          IsHitTestVisible="False"
          IsVisible="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:SliderTrackAppearance.HasTrackLength}}"
          Margin="{TemplateBinding controls:SliderTrackAppearance.FillMargin}"
          Height="{TemplateBinding controls:SliderTrackAppearance.Height}"
          VerticalAlignment="Center"
          Background="{TemplateBinding Background}"
          CornerRadius="{TemplateBinding controls:SliderTrackAppearance.CornerRadius}"
        />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
