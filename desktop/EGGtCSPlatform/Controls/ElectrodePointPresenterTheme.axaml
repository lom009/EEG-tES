<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:EGGtCSPlatform.Controls"
  xmlns:pages="clr-namespace:EGGtCSPlatform.ViewModels.Pages"
>
  <ControlTheme x:Key="ElectrodePointPresenterTheme" TargetType="ContentPresenter">
    <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
    <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
  </ControlTheme>
</ResourceDictionary>
